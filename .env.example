# Copy to .env.local (never committed) and fill in from your Supabase project:
# Project settings → API keys (and Data API for the URL).

# The project URL and its anon (publishable) key. Safe in the browser: every
# query runs as the signed-in person, and the policies in supabase/schema.sql
# decide what they see — an admin everything, a member only their own share.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service-role key, for the Members page only: creating sign-ins,
# setting passwords, deactivating. It bypasses every policy, so it stays on
# the server — no NEXT_PUBLIC_ prefix, never in the browser, never committed.
# Without it the app works, but members can't be managed from it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The time zone "today" is read in (an IANA name), which decides
# the current month and a new transaction's default date. New York if unset.
# NEXT_PUBLIC_TIME_ZONE=America/New_York
